{
  "name": "playwright-direct",
  "version": "0.1.0",
  "description": "Drive an existing Chrome/Edge session from Playwright over CDP, through a companion extension. No debug port, no relaunch, no re-login.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/wucong220/playwright-direct.git" },
  "homepage": "https://github.com/wucong220/playwright-direct#readme",
  "bugs": { "url": "https://github.com/wucong220/playwright-direct/issues" },
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "extension", "cordis.patch.yml", "README.md", "LICENSE"],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cdp",
    "chrome-extension",
    "playwright",
    "browser-automation"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "cross-spawn": "7.0.6",
    "playwright-core": "1.64.0",
    "ws": "8.22.0",
    "zod": "4.1.12"
  },
  "engines": { "node": ">=22" }
}
